TOKEN=your token here
PREFIX=~

# YouTube не отдаёт аудио анонимным запросам ("Sign in to confirm you're not
# a bot", "This video requires login"). OAuth пускает за стену логина, 
# а cipher-сервер даёт TV клиенту signatureTimestamp,
# который встроенный парсер player script вытащить не может

# Сервер расшифровки подписи. Поднять рядом:
# docker run -d -p 8001:8001 ghcr.io/kikkia/yt-cipher:master
# Если бот сам в контейнере, 127.0.0.1 будет указывать на него же.
# Использовать host.docker.internal:8001 или общую сеть docker compose.
YT_CIPHER_URL=http://127.0.0.1:8001

# OAuth. Работает через клиент TV, который подключается
# только с этой настройкой. Использовать одноразовый аккаунт.
# При YT_OAUTH=true в логе появится ссылка, код и refresh token.
# Полученный токен подставить ниже, чтобы больше не проходить вход
#YT_OAUTH=true
YT_OAUTH_REFRESH_TOKEN=

# poToken (только клиенты WEB и WEBEMBEDDED)
# Оставлен на случай другого IP. Получить bgutil-ytdlp-pot-provider
#YT_PO_TOKEN=
#YT_VISITOR_DATA=
